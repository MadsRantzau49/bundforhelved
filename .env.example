# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Bump this on non-Vercel deployments to force a fresh PWA cache.
NEXT_PUBLIC_APP_VERSION=local-v1
# Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional when Next.js and Supabase use separate Docker hostnames.
SUPABASE_INTERNAL_URL=
# Set false only for a localhost production container served over HTTP.
AUTH_COOKIE_SECURE=true

# Server-only values. Generate the pepper with: openssl rand -base64 32
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_PASSWORD_PEPPER=replace-with-a-long-random-secret
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
